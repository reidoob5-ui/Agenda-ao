# ============================================================
# AgendaAO — Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores reais
# ============================================================

# Base de dados PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/agendaao"

# JWT
JWT_SECRET="muda_este_segredo_para_algo_muito_longo_e_aleatorio"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ============================================================
# MULTICAIXA EXPRESS (EMIS Angola)
# Obtém estas credenciais em https://emis.co.ao ou banco parceiro
# ============================================================
EMIS_MERCHANT_ID=AO_MERCHANT_XXXXX
EMIS_TERMINAL_ID=TERM_XXXXX
EMIS_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
EMIS_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxx
# Muda para https://api.multicaixa.ao/express/v1 em produção
EMIS_BASE_URL=https://sandbox.multicaixa.ao/express/v1

# ============================================================
# WhatsApp (usa Twilio, Z-API ou WPPConnect)
# Opção recomendada para Angola: Z-API (z-api.io)
# ============================================================
WHATSAPP_PROVIDER=zapi
ZAPI_INSTANCE_ID=xxxxxxxxxxxxxxxx
ZAPI_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
ZAPI_BASE_URL=https://api.z-api.io/instances

# ============================================================
# SMS (opcional — usa Africell ou Unitel SMS gateway)
# ============================================================
SMS_PROVIDER=africell
SMS_API_KEY=xxxxxxxxxxxxxxxx
SMS_SENDER=AgendaAO

# ============================================================
# Email (para notificações internas)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=teu@email.com
SMTP_PASS=app_password_aqui
EMAIL_FROM="AgendaAO <noreply@agendaao.ao>"

# ============================================================
# Upload de ficheiros (logo, fotos)
# ============================================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Login com Google (ID do cliente OAuth do Google Cloud Console).
# Quando preenchido, as contas novas so podem ser criadas com Google.
GOOGLE_CLIENT_ID=

# WhatsApp oficial (Meta Cloud API). Sem token e Phone ID fica desligado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Planos que podem usar WhatsApp automatico (cada mensagem custa dinheiro)
WHATSAPP_PLANOS=PREMIUM
# Limite de mensagens por mes, por negocio
WHATSAPP_LIMITE_MES=500
# Nomes dos modelos aprovados na Meta (por defeito os abaixo)
WHATSAPP_TEMPLATE_CONFIRMACAO=confirmacao_marcacao
WHATSAPP_TEMPLATE_LEMBRETE=lembrete_marcacao
